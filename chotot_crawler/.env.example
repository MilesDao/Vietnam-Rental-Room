# Chợ Tốt API Base URL
CHOTOT_API_URL=https://gateway.chotot.com/v1/public/ad-listing

# Crawl Settings
# Region codes: 12000 = Hà Nội, 13000 = TP. Hồ Chí Minh
REGION_ID=12000
TARGET_DATA=7000
LIMIT_PER_REQUEST=20

# Delay range between requests (seconds)
DELAY_MIN=1.5
DELAY_MAX=3.0

# Categories to crawl (comma-separated):
# 1050: Phòng trọ, 1010: Căn hộ/Chung cư, 1020: Nhà ở
CATEGORIES=1050,1010,1020
